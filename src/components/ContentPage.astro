---
import ContentBody from "./ContentBody.astro";
import InnerPage from "./InnerPage.astro";

interface Props {
    title: string;
    pageTitle?: string;
    backHref?: string;
    description?: string;
}
const { title, pageTitle, backHref = "/", description } = Astro.props;
---

<InnerPage title={title} pageTitle={pageTitle} description={description} backHref={backHref}>
    <ContentBody>
        <slot />
    </ContentBody>
</InnerPage>
