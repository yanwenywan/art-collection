---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    image: ImageMetadata | Promise<{ default: ImageMetadata }>;
    caption?: string;
    alt?: string;
    left?: boolean;
    right?: boolean;
    maxWidth?: string;
    maxHeight?: string;
}
const { image, caption, alt, left, right, maxWidth, maxHeight } = Astro.props;

const side = right ? "right" : "left";

const capped = Boolean(maxHeight && !maxWidth);
const bleedStyle = maxWidth ? `--side-max-w:${maxWidth}` : undefined;
const imgStyle = capped ? `--side-max-h:${maxHeight}` : undefined;
---

<div class:list={["side-image-bleed", `side-image-bleed--${side}`]} style={bleedStyle}>
    <div class="side-image">
        <Image
            src={image}
            alt={alt ?? caption ?? ""}
            class:list={["side-image-img", { "side-image-img--capped": capped }]}
            style={imgStyle}
            data-caption={caption}
        />
        {caption && <p class="side-image-caption">{caption}</p>}
    </div>
</div>

<script>import "../scripts/lightbox.ts";</script>

<style lang="scss">
    @use "../styles/tokens" as *;

    .side-image-bleed {
        max-width: var(--side-max-w, 50%);
        margin-top: $gap;
        margin-bottom: $gap;

        &--left {
            float: left;
            margin-left: calc($gap * -2.5);
            margin-right: $gap;
        }

        &--right {
            float: right;
            margin-right: calc($gap * -2.5);
            margin-left: $gap;
        }

        @media screen and (max-width: 768px) {
            float: none;
            max-width: 100%;
            margin-left: -$gap;
            margin-right: -$gap;
        }
    }

    .side-image {
        padding: $gap;
        background: $color-surface;
        text-align: center;
    }

    .side-image-caption {
        font-family: $font-body;
        font-size: 0.85rem;
        color: $color-muted;
        line-height: 1.6;
        margin: 0;
    }

    .side-image-img {
        display: block;
        margin: 0 auto calc($gap / 2);
        max-width: 100%;
        height: auto;
    }

    .side-image-img--capped {
        max-height: var(--side-max-h);
        max-width: 100%;
        width: auto;
    }
</style>
