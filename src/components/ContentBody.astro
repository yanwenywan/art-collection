---
interface Props {
    /** Square versus the default long top and longer bottom padding */
	squarePadding?: boolean;
}

const { squarePadding = false } = Astro.props;
---

<div class={"content-body" + 
            (squarePadding ? " square" : "")}>
    <slot />
</div>

<style lang="scss">
    @use "../styles/tokens" as *;

    .content-body {
        max-width: 840px;
        width: 90%;
        margin: 0 auto;
        padding: $gap * 2 $gap * 2.5 $gap * 3;
        font-family: $font-body;
        color: $color-text;
        line-height: 1.7;
        background: $color-page;

        @media screen and (max-width: 768px) {
            padding: $gap * 2 $gap $gap * 3;

            .square {
                padding: $gap
            }
        }

        .square {
            padding: $gap * 2;
        }
    }
</style>
