---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPage from "../../components/ContentPage.astro";
import Feature from "../../components/Feature.astro";
---

<BaseLayout title="Yan Xin">
    <ContentPage
        title="燕昕 Yan Xin"
        description="King Qin of Yan, who founded the Yan dynasty and started dragonkind's dynastic rule over the central plains."
        backHref="/"
    >
        <h2>Yan Xin</h2>

        <Feature
            image={import("../../content/albums/chars/qin-of-yan.jpg")}
            alt="king qin of yan"
            title="Yan Xin, King Qin of Yan"
        />

        <p>
            Founding emperor of the Yan Dynasty, the first draconic dynasty to unify the central plains.
            Originally King Qin of the Yan kingdom in Damak and the western mountains.
        </p>
    </ContentPage>
</BaseLayout>
