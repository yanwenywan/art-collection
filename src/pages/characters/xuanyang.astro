---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPage from "../../components/ContentPage.astro";
import Feature from "../../components/Feature.astro";
---

<BaseLayout title="Xuanyang">
    <ContentPage
        title="玄陽 Xuanyang"
        description="A Heaven-dragon, beast of heavenly tribulation, tyrant of the east sea and lord of all winged dragons in the twilight realm."
        backHref="/"
    >
        <h2>Xuanyang</h2>

        <Feature
            image={import("../../content/albums/chars/xuanyang.jpg")}
            alt="xuanyang portrait"
            title="Xuanyang portrait"
            maxHeight="480px"
        />

        <p>
            Tyrant of the east sea, he has almost all dragonkind in the elven realm under his yoke.
        </p>

    </ContentPage>
</BaseLayout>
