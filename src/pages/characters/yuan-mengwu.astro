---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPage from "../../components/ContentPage.astro";
import Feature from "../../components/Feature.astro";
---

<BaseLayout title="Yuan Mengwu">
    <ContentPage
        title="元夢吾 Yuan Mengwu"
        description="The Taoist Mengyun, nascent soul heart cultivator, elder of the House of Stars"
        backHref="/"
    >
        <h2>Yuan Mengwu</h2>

        <Feature
            image={import("../../content/albums/chars/yuan-mengwu-ref.jpg")}
            alt="yuan mengwu reference sheet"
            title="Reference sheet"
        />


        
        <p>
            Native to the east sea, Nascent Soul elder of the dragon palace in the House of Stars.
            A very rare maned purple dragon, possibly a descendant of the eastern Azure Dragon lineages
            from the ancient Star Venerable.
        </p>
    </ContentPage>
</BaseLayout>
