---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentPage from "../../components/ContentPage.astro";
import Feature from "../../components/Feature.astro";
---

<BaseLayout title="Ouyang Zhan">
    <ContentPage
        title="歐陽湛 Ouyang Zhan"
        description="Leader of the Ouyang Sect in Jinhuashan. Later the Jinhua Immortal, disciple of the Moon Venerable."
        backHref="/"
    >
        <h2>Ouyang Zhan</h2>
        
        <Feature
            image={import("../../content/albums/chars/ref-ouyang-zhan.jpg")}
            alt="Ouyang zhan Reference"
            title="Ouyang Zhan Simple Reference"
        />

        <p>
            Master of the Ouyang Sect in Jinshan, a Transforming Spirit cultivator at the peak of power. 
            Generally considered the most powerful cultivator in the central plains, rivalling An Ye 
            (when she was still mortal) in the East Sea.
        </p>

        <p>
            He is a heart cultivator, favouring the Qin as his main weapon, though he also wields the jade claws which are the ancestral magic weapon of the Ouyang clan.
        </p>

        <p>
            Later, he would transcend his tribulation atop the divine mountain Damak Dai, and be ordained the second disciple of the Rain God, titled "Jinhua" after his homeland.
        </p>

        <Feature
            image={import("../../content/albums/chars/ouyang-zhan.png")}
            alt="Ouyang zhan picture"
            title="The Jinhua Immortal"
        />
    </ContentPage>
</BaseLayout>
